{
  "regions": [
    "sin1"
  ],
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 120,
      "includeFiles": "{dist/**,prisma/schema.prisma,node_modules/.prisma/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
