# api.gotravelnha.com (NestJS). Copy to .env. Swagger at /docs, health at /health.

PORT=3002

# Database (same Postgres the site used before the split)
DATABASE_URL=postgresql://user:password@localhost:5432/gotravelnha
DIRECT_URL=

# Session cookie shared by www, admin and api (at least 32 random characters, `openssl rand -hex 32`)
SESSION_PASSWORD=
# Prod: .gotravelnha.com   Local: leave empty (localhost cookies are shared across ports)
SESSION_COOKIE_DOMAIN=

# Public origins
NUXT_PUBLIC_API_URL=http://localhost:3002
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Browser origins allowed to call the API with credentials (site and admin URLs are always allowed)
CORS_ORIGINS=https://www.gotravelnha.com,https://gotravelnha.com,https://admin.gotravelnha.com

# Keycloak (auth.gotravelnha.com). Redirect URI registered on the client: ${NUXT_PUBLIC_API_URL}/auth/callback
OIDC_ISSUER=https://auth.gotravelnha.com/realms/gotravelnha
OIDC_CLIENT_ID=gotravelnha-web
# GTN_WEB_CLIENT_SECRET from the keycloak/ deployment
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=gotravelnha-api
# Service account for creating users / sending "set your password" emails (IAM_ADMIN_CLIENT_SECRET)
KEYCLOAK_ADMIN_CLIENT_ID=iam-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Trip planner (Claude API)
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Trip.com / Klook
TRIP_ALLIANCE_ID=3883416
TRIP_SID=22874365
KLOOK_AD_ID=your_klook_ad_id
KLOOK_AFFILIATE_ID=your_klook_ad_id

# Affiliate conversion postbacks (/api/affiliate/postback). At least 16 random characters; empty disables.
AFFILIATE_POSTBACK_SECRET=

NUXT_PUBLIC_SUPPORT_EMAIL=
NUXT_PUBLIC_ENABLE_COMMUNITY=false
NUXT_PUBLIC_COMMUNITY_DEMO=false

# --- Video studio (admin → Videos; src/videos/studio) ---
# Renders need FFmpeg and Chromium (npm run video:install) on a long-running host; they are refused on Vercel.
# VIDEO_STUDIO_DATA_DIR=storage/video-studio
# Configure ONE production TTS provider. Without one, the voice stage fails on purpose.
# Override the config's voice.provider: auto | elevenlabs | google | azure | say
#   auto → ElevenLabs, then Google, then Azure — whichever has credentials.
#   say  → macOS "Linh" voice; DRAFT only, outputs get a -DRAFT suffix and validation fails.
TTS_PROVIDER=auto

# ElevenLabs (recommended; gives word timings for subtitle sync)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Google Cloud Text-to-Speech (word timings via SSML marks)
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_ACCESS_TOKEN=
GOOGLE_TTS_VOICE=vi-VN-Neural2-A
GOOGLE_TTS_RATE=1.05

# Azure AI Speech (timings estimated)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_TTS_VOICE=vi-VN-HoaiMyNeural

# macOS say (TTS_PROVIDER=say)
SAY_VOICE=Linh
SAY_RATE=185

# Pipeline
# VIDEO_CONFIG=config/short-01-v2.json
# CAPTURE_ONLY=tokyo,customize
# KEEP_RAW_FRAMES=1
